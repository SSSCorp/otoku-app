# Copy to `.env` and fill in your own keys. `.env` is gitignored.
#
# Google Maps Platform key (Maps SDK for Android).
# Restrict it to your app's package name + SHA-1 before shipping.
GOOGLE_MAPS_API_KEY=

# Map renderer: `osm` (default, works everywhere), `google` (needs billing +
# Maps SDK for Android), or `illustrated` (offline preview).
MAP_PROVIDER=osm
